{
  "name": "tetris_multi",
  "version": "1.0.0",
  "main": "dist/server/app.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node dist/server/app.js",
    "start": "node dist/server/app.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "build": "node scripts/build.js",
    "build:server": "node scripts/build.js --server",
    "db:migrate": "node dist/server/server/db/migrateCli.js",
    "db:import-jsonl": "node dist/server/server/db/importJsonl.js",
    "test": "npm run build:server && npm run test:compiled",
    "test:compiled": "node --test",
    "test:artifact": "node --test test-artifact/serverBuildArtifact.js",
    "pretest:db": "npm run build:server",
    "test:db": "node scripts/run-postgres-tests.js",
    "test:release": "node --test test-artifact/productionRelease.js",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:vite-dev": "PLAYWRIGHT_VITE_DEV=1 playwright test e2e/reactShellLifecycle.spec.js e2e/singleReactLifecycle.spec.js e2e/multiplayerReactLifecycle.spec.js",
    "dataset:export": "node scripts/export-placement-dataset.js",
    "dataset:evaluate": "node scripts/evaluate-placement-dataset.js",
    "model:train-placement-ranker": "node scripts/train-placement-ranker.js",
    "model:export-placement-parity": "node scripts/export-placement-parity-bundle.js",
    "model:compare-placement-parity": "conda run -n tetris-ml python scripts/ml/placement_pairwise_parity.py",
    "verify:ml": "bash scripts/verify-ml.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "socket.io": "^4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
