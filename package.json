{
  "name": "tetris_multi",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node src/app.js",
    "start": "node src/app.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "build": "vite build",
    "test": "node --test",
    "test:e2e": "playwright test",
    "dataset:export": "node scripts/export-placement-dataset.js",
    "dataset:evaluate": "node scripts/evaluate-placement-dataset.js",
    "model:train-placement-ranker": "node scripts/train-placement-ranker.js",
    "model:export-placement-parity": "node scripts/export-placement-parity-bundle.js",
    "model:compare-placement-parity": "conda run -n tetris-ml python scripts/ml/placement_pairwise_parity.py",
    "verify:ml": "bash scripts/verify-ml.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
